<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- 1. Encabezado: Badge de Estado e ID -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvAdminEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_badge_abierto"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="ABIERTO"
                android:textColor="@color/badge_abierto_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminIdPartido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Id: 101"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- 2. Metadatos: Fecha | Hora | Estadio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAdminFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 12 jun 2026"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   |   "
                android:textColor="@color/border_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAdminHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕒 16:00"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="   |   "
                android:textColor="@color/border_gray"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAdminEstadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="🏟 Estadio Azteca"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 3. Sección Central: Enfrentamiento y Panel de Control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lado Izquierdo: Selecciones y Banderas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Selección 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivBandera1"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/flag_placeholder" />

                    <TextView
                        android:id="@+id/tvAdminSeleccion1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="España"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- VS o Marcador Resumen -->
                <TextView
                    android:id="@+id/tvVsOMarcador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:text="VS"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Selección 2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivBandera2"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/flag_placeholder" />

                    <TextView
                        android:id="@+id/tvAdminSeleccion2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Argentina"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lado Derecho: Controles según Estado -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:paddingStart="8dp">

                <!-- Estado ABIERTO: Botón verde con candado -->
                <Button
                    android:id="@+id/btnCerrarPronosticos"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:backgroundTint="@color/btn_green"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="🔒 Cerrar pronósticos"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    app:cornerRadius="6dp" />

                <!-- Estado CERRADO: Formulario de ingreso de goles -->
                <LinearLayout
                    android:id="@+id/layoutAdminCerrado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:text="Resultado oficial"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Input País 1 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblGolesSel1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="Goles Sel 1"
                                android:textColor="@color/text_secondary"
                                android:textSize="8sp" />

                            <EditText
                                android:id="@+id/etGolesOficial1"
                                android:layout_width="38dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_input_box"
                                android:gravity="center"
                                android:inputType="number"
                                android:text="0"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="4dp"
                            android:text=" : "
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Input País 2 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblGolesSel2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="Goles Sel 2"
                                android:textColor="@color/text_secondary"
                                android:textSize="8sp" />

                            <EditText
                                android:id="@+id/etGolesOficial2"
                                android:layout_width="38dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_input_box"
                                android:gravity="center"
                                android:inputType="number"
                                android:text="0"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnGuardarResultado"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="5dp"
                        android:backgroundTint="@color/btn_green"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="💾 Guardar resultado"
                        android:textColor="#FFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:cornerRadius="6dp" />
                </LinearLayout>

                <!-- Estado FINALIZADO: Marcador oficial fijado -->
                <LinearLayout
                    android:id="@+id/layoutAdminFinalizado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="3dp"
                        android:text="Resultado oficial"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- País 1 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblFinGolesSel1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="Goles Sel 1"
                                android:textColor="@color/text_secondary"
                                android:textSize="8sp" />

                            <TextView
                                android:id="@+id/tvGolesFin1"
                                android:layout_width="38dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_input_box"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:paddingHorizontal="4dp"
                            android:text=" : "
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- País 2 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblFinGolesSel2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="2dp"
                                android:text="Goles Sel 2"
                                android:textColor="@color/text_secondary"
                                android:textSize="8sp" />

                            <TextView
                                android:id="@+id/tvGolesFin2"
                                android:layout_width="38dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_input_box"
                                android:gravity="center"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- 4. Banner Informativo Inferior -->
        <TextView
            android:id="@+id/tvMsgInformativo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_info_box"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="ⓘ Los participantes pueden registrar o modificar sus pronósticos."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
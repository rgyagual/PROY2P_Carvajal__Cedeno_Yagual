<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_TablaPosiciones"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".TablaPosicionesActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="wrap_content"
                android:layout_height="200dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/bannerff" />

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:layout_marginLeft="290dp"
                android:layout_marginTop="5dp"
                app:srcCompat="@drawable/loglogin" />

            <LinearLayout
                android:layout_width="277dp"
                android:layout_height="180dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_perfilAdmin"
                    android:layout_width="110dp"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/user_icon_on_transparent_background_free_png" />

                <LinearLayout
                    android:id="@+id/BienvenidoLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="60dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_bienvenido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bienvenido,"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_nombreParticipante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="nombre P"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_participante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Participante"
                        android:textColor="#4CAF50"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TextView" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="120dp"
                android:layout_height="70dp"
                android:layout_weight="1"
                app:srcCompat="@drawable/copa" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:text="Tabla de posiciones"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Asi van los participantes del mundial 2026" />
            </LinearLayout>

        </LinearLayout>

        <ScrollView
            android:id="@+id/scv_tablaPosicion"
            android:layout_width="match_parent"
            android:layout_height="330dp">

            <TableLayout
                android:id="@+id/tb_tablaPosiciones"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#021D97" />
        </ScrollView>

        <androidx.cardview.widget.CardView
            android:id="@+id/btn_volver"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_marginLeft="120dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/borde_card_black"
            android:onClick="volver"
            app:cardBackgroundColor="#05FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/borde_card_black"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="1dp"
                    android:padding="10dp"
                    android:scaleType="fitXY"
                    app:srcCompat="?attr/homeAsUpIndicator" />

                <TextView
                    android:id="@+id/textView4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="Volver"
                    android:textColor="#000D5F"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:orientation="vertical">

    <!-- 1. Barra Superior (Header) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAdmin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/header_navy"
        app:navigationIcon="@drawable/ic_menu_white"
        app:title="Administrar partidos"
        app:titleTextColor="@color/white" />

    <!-- 2. Contenido Scrollable -->
    <ScrollView
        android:id="@+id/scrollVAdmin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sección Fase del Torneo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:text="Fase del torneo"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Selector de Fase -->
            <Spinner
                android:id="@+id/spFasesAdmin"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:paddingHorizontal="10dp" />

            <!-- Banner informativo según diseño PDF -->
            <TextView
                android:id="@+id/tvInfoGuiaAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_info_box"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp"
                android:text="ⓘ  Administra los partidos según su estado"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Subtítulo antes de la lista -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:text="Partidos de la fase seleccionada"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Contenedor dinámico donde se inyectan las tarjetas de item_partido_admin -->
            <LinearLayout
                android:id="@+id/layoutPartidosAdminContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- 3. Botón Inferior "Volver al menú principal" -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverAdminMenu"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginVertical="10dp"
        android:text="Volver al menú principal"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_arrow_back"
        app:iconGravity="textStart"
        app:iconTint="@color/text_primary"
        app:strokeColor="@color/border_gray" />

</LinearLayout>